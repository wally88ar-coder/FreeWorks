<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <!-- Fork: nombre visible en el Addon Manager "FreeWorks" (decisión del usuario, 2026-10-31).
       El banco sigue registrado como "LikeSolidWorks UI" (abajo en <content>, igual que MenuText
       en InitGui.py; en pantalla dice FreeWorks por swui/fork/brand.py). La búsqueda del Addon
       Manager mira nombre, descripción y <tag>: por eso "LikeSolidWorks UI" sigue en los tags. -->
  <name>FreeWorks</name>
  <description>
    FreeWorks: interfaz y flujo de trabajo estilo SOLIDWORKS 2018 para FreeCAD, en
    castellano. Cinta tipo CommandManager, chapa metálica sobre el addon SheetMetal con
    DXF del desarrollo en un clic, propiedades físicas, ecuaciones, mover/rotar cara,
    relaciones de posición y planos. Fork de LikeSolidWorks UI (Dominik Ladewig).
    SOLIDWORKS-like interface for FreeCAD (Spanish), fork of LikeSolidWorks UI.
    SOLIDWORKS es una marca de Dassault Systemes; este proyecto no está relacionado
    con Dassault Systemes. Not affiliated with Dassault Systemes.
  </description>
  <version>0.10.0</version>
  <date>2026-10-18</date>

  <maintainer email="347947152+wally88ar-coder@users.noreply.github.com">wally88ar-coder</maintainer>
  <author email="ladewig_dominik@web.de">Dominik Ladewig</author>

  <!-- Zwei Lizenzen: Quelltext LGPL (wie FreeCAD selbst), Grafiken und
       Vorlagen CC-BY-SA (die LGPL passt schlecht auf Nicht-Quelltext).
       Die Bezeichner sind offizielle SPDX-Kuerzel - nicht abkuerzen,
       sonst stuft der Addon-Manager sie strenger ein. -->
  <license file="LICENSE-Code">LGPL-2.1-or-later</license>
  <license file="LICENSE-Assets">CC-BY-SA-4.0</license>

  <!-- Fork: el repositorio propio. Como en el original, los usuarios reciben la rama "release"
       (solo versiones revisadas, tools/freigabe.sh); se desarrolla en "master". -->
  <url type="repository" branch="release">https://github.com/wally88ar-coder/FreeWorks</url>
  <url type="readme">https://github.com/wally88ar-coder/FreeWorks/blob/release/README.md</url>

  <freecadmin>1.0</freecadmin>

  <tag>FreeWorks</tag>
  <tag>LikeSolidWorks UI</tag>
  <tag>LikeSolidWorks</tag>
  <tag>Ribbon</tag>
  <tag>TechDraw</tag>
  <tag>Deutsch</tag>
  <tag>English</tag>
  <tag>Español</tag>
